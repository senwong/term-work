#!/usr/bin/env python3
"""Persistent Claude workspaces across macOS terminals (stdlib only)."""
import argparse
import fcntl
import json
import os
from pathlib import Path
import subprocess
import sys
import uuid
from contextlib import contextmanager

ROOT = Path(os.environ.get('TERM_WORK_HOME', str(Path.home() / '.local/share/term-work')))
SELF = str(Path(__file__).resolve())

from terminals import Terminal, NAMES, choose, executable, installed, gui_identity

@contextmanager
def database():
    ROOT.mkdir(parents=True, exist_ok=True, mode=0o700)
    with (ROOT / 'registry.lock').open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        file = ROOT / 'tasks.json'
        data = json.loads(file.read_text()) if file.exists() else {}
        yield data
        temp = ROOT / 'tasks.tmp'
        temp.write_text(json.dumps(data, ensure_ascii=False, indent=2) + '\n')
        temp.replace(file)

def cli(*args):
    return subprocess.check_output([executable('kaku'), 'cli', '--no-auto-start', *args], text=True, timeout=10).strip()

def running(task):
    for session in live_sessions(Path(task['config'])):
        if session['sessionId'] == task['session']:
            return True
    with (ROOT / (task['key'] + '.lock')).open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            return False
        except BlockingIOError:
            return True

def live_sessions(config):
    result = []
    for file in (config / 'sessions').glob('*.json'):
        try:
            session = json.loads(file.read_text())
            pid = int(session['pid'])
            proc = subprocess.check_output(['ps', '-p', str(pid), '-o', 'lstart=', '-o', 'tty='],
                                           text=True, timeout=5, env=dict(os.environ, TZ='UTC', LC_ALL='C')).strip()
            start = session.get('procStart', '')
            if start and ' '.join(proc.split()[:5]) == ' '.join(start.split()):
                session['tty'] = '/dev/' + proc.split()[-1]
                result.append(session)
        except (ValueError, KeyError, OSError, subprocess.SubprocessError):
            continue
    return result

def save_tabs(terminal=None):
    from watcher import Observer
    config = Path(os.environ.get('CLAUDE_CONFIG_DIR', str(Path.home() / '.claude'))).resolve()
    sessions = live_sessions(config)
    names = [terminal] if terminal else [n for n in NAMES if installed(n) and gui_identity(n)]
    failures = []
    for name in names:
        try:
            identity = gui_identity(name)
            if not identity:
                raise ValueError('请先打开 ' + name)
            panes = Terminal(name).panes()
            if gui_identity(name) != identity:
                raise ValueError('终端在读取期间退出，请重试。')
            with database() as data:
                before = len(data)
                Observer(name).update(data, panes, sessions, identity, config, 0)
                print(f'{name}: 新增 {len(data) - before} 个需求，已更新现有会话。')
        except (ValueError, OSError, subprocess.SubprocessError) as exc:
            print(f'{name}: {exc}', file=sys.stderr)
            failures.append(name)
    if failures:
        raise ValueError('部分终端读取失败，原记录保留。')
    if not names:
        print('没有运行中的受支持终端。')

def launch(name, task, terminal=None):
    if running(task):
        with database() as data:
            if name in data:
                data[name]['state'] = 'active'
        print(f'跳过正在运行的需求：{name}')
        return
    if not Path(task['cwd']).is_dir():
        raise ValueError(f'工作目录不存在：{task["cwd"]}')
    backend = terminal or task.get('terminal', 'kaku')
    argv = ['/usr/bin/env', 'TERM_WORK_HOME=' + str(ROOT), '/bin/zsh', '-lc',
            '"$1" "$2" _run "$3"; exec /bin/zsh -l', 'work', sys.executable, SELF, name]
    pane = Terminal(backend).spawn(task['cwd'], argv, name)
    with database() as data:
        if name in data:
            data[name]['state'] = 'active'
            data[name]['terminal'] = backend
            if pane:
                data[name]['pane_id'] = str(pane)
    print(f'已打开：{name}')

def run(name):
    with database() as data:
        task = dict(data[name])
    with (ROOT / (task['key'] + '.lock')).open('a') as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print('此需求已在其他 Tab 运行。')
            return
        os.chdir(task['cwd'])
        config = Path(task['config'])
        exists = any((config / 'projects').glob('*/' + task['session'] + '.jsonl'))
        flag = '--resume' if exists or task.get('tracked') else '--session-id'
        # SessionStart also captures session changes caused by /clear or /resume.
        import shlex
        hook = shlex.join([sys.executable, SELF, '_record', name])
        settings = json.dumps({'hooks': {'SessionStart': [{'hooks': [
            {'type': 'command', 'command': hook}]}]}})
        env = dict(os.environ, CLAUDE_CONFIG_DIR=str(config))
        subprocess.call([executable('claude'), flag, task['session'], '--settings', settings], env=env)

def main():
    parser = argparse.ArgumentParser(description='Kaku / WezTerm / iTerm2 / Ghostty + Claude 会话一键恢复')
    parser.add_argument('--version', action='version',
                        version='term-work ' + Path(SELF).with_name('VERSION').read_text().strip())
    sub = parser.add_subparsers(dest='cmd', required=True)
    p = sub.add_parser('start', help='新建需求并打开 Tab；同名需求恢复')
    p.add_argument('name'); p.add_argument('--cwd', default=os.getcwd())
    p.add_argument('--terminal', choices=NAMES)
    p = sub.add_parser('track', help='登记已有会话，不启动；先退出对应 Claude 会话')
    p.add_argument('name'); p.add_argument('session_id'); p.add_argument('--cwd', default=os.getcwd())
    p.add_argument('--terminal', choices=NAMES)
    p = sub.add_parser('restore', help='恢复所有未完成需求')
    p.add_argument('name', nargs='?'); p.add_argument('--dry-run', action='store_true')
    p.add_argument('--terminal', choices=NAMES, help='覆盖恢复目标终端')
    sub.add_parser('list', help='列出已登记需求')
    p = sub.add_parser('save', help='立即扫描终端中的 Claude 会话')
    p.add_argument('--terminal', choices=NAMES)
    sub.add_parser('terminals', help='查看终端安装及运行状态')
    sub.add_parser('watch', help='持续监听终端和 Claude，每 3 秒检查一次')
    p = sub.add_parser('done', help='移出恢复列表，保留 Claude 历史，不终止进程')
    p.add_argument('name')
    for command in ('_run', '_record'):
        p = sub.add_parser(command, help=argparse.SUPPRESS); p.add_argument('name')
    args = parser.parse_args()
    if args.cmd == 'terminals':
        for name in NAMES:
            print(name, '已安装' if installed(name) else '未找到', '运行中' if gui_identity(name) else '未运行')
        return
    if args.cmd == 'watch':
        from watcher import watch
        return watch(sys.modules[__name__])
    if args.cmd == 'save':
        return save_tabs(args.terminal)
    if args.cmd == '_record':
        event = json.load(sys.stdin)
        sid = str(uuid.UUID(event['session_id']))
        with database() as data:
            if args.name in data:
                data[args.name]['session'] = sid
                data[args.name]['tracked'] = True
        return
    if args.cmd == '_run':
        return run(args.name)
    with database() as data:
        if args.cmd in ('start', 'track'):
            if args.cmd == 'track' and args.name in data:
                raise ValueError('需求名称已存在，请使用其他名称。')
            if args.name not in data:
                cwd = str(Path(args.cwd).expanduser().resolve())
                if not Path(cwd).is_dir():
                    raise ValueError('工作目录不存在。')
                sid = str(uuid.UUID(args.session_id)) if args.cmd == 'track' else str(uuid.uuid4())
                if any(t['session'] == sid for t in data.values()):
                    raise ValueError('此会话已登记。')
                data[args.name] = dict(key=str(uuid.uuid4()), cwd=cwd, session=sid,
                    config=str(Path(os.environ.get('CLAUDE_CONFIG_DIR', str(Path.home() / '.claude'))).resolve()),
                    tracked=args.cmd == 'track', terminal=choose(args.terminal))
        elif args.cmd == 'done':
            data[args.name]['state'] = 'done'
            print('已移出恢复列表；Claude 历史保留。')
        snapshot = dict(data)
    if args.cmd == 'list':
        for name, task in snapshot.items():
            state = task.get('state', 'active')
            label = {'closed': '已关闭（默认不恢复）', 'done': '已完成', 'uncertain': '待恢复（退出原因不明）'}.get(state)
            label = label or ('运行中' if running(task) else '待恢复')
            print(f"{name}\t{label}\t{task.get('terminal', 'kaku')}\t{task['cwd']}\t{task['session']}")
        if not snapshot:
            print('暂无需求。使用 work start 名称，或 work track 名称 会话ID。')
    elif args.cmd == 'track':
        print(f'已登记：{args.name}；执行 work restore 恢复。')
    elif args.cmd in ('start', 'restore'):
        selected = {args.name: snapshot[args.name]} if args.name else {
            n: t for n, t in snapshot.items() if t.get('state') not in ('closed', 'done')}
        failures = []
        for name, task in selected.items():
            if getattr(args, 'dry_run', False):
                print(f"{name}\t{args.terminal or task.get('terminal', 'kaku')}\t{task['cwd']}\t{task['session']}")
                continue
            try:
                launch(name, task, args.terminal)
            except (subprocess.SubprocessError, OSError, ValueError) as exc:
                failures.append(name)
                print(f'恢复失败 {name}: {exc}', file=sys.stderr)
        if failures:
            raise ValueError('请确认对应终端已打开，然后重试 work restore；需求记录已保留。')

if __name__ == '__main__':
    try:
        main()
    except (ValueError, KeyError, OSError, subprocess.SubprocessError) as exc:
        print(f'work: {exc}', file=sys.stderr)
        sys.exit(1)
